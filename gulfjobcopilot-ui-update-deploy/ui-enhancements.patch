+    --gold-500: #d9ad3f;
+    --gold-600: #ecc973;
+
+    --emerald-50: #102a1f;
+    --emerald-100: #153b2b;
+    --emerald-400: #2bc895;
+    --emerald-500: #22a874;
+    --emerald-600: #1f9465;
+    --emerald-700: #3fe0a5;
+
+    --sand-100: #1a221c;
+    --sand-200: #222c24;
+  }
