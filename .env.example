# --- Supabase (auth, database, storage) ---
# Create a free project at https://supabase.com, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role ("secret") key — server-only, used by the billing webhook to
# mark a user's plan as "pro" after payment. NEVER prefix with NEXT_PUBLIC_
# and never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing ---
# Which provider is active: "lemonsqueezy" (default) or "stripe"
BILLING_PROVIDER=lemonsqueezy

# Lemon Squeezy (https://lemonsqueezy.com) — recommended primary, see plan doc §3
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_YEARLY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Stripe (alternative)
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- AI (resume enhancement + chatbot) ---
ANTHROPIC_API_KEY=

# --- Real job search ---
# Free developer key from https://jooble.org/api/about — without it, job
# search falls back to the public Greenhouse/Lever/Ashby boards + curated
# demo listings only. This is the single biggest lever on result volume.
JOOBLE_API_KEY=

# --- Admin notification emails (new signups, new/renewed/cancelled subs) ---
# From resend.com (Settings > API Keys). Without this, notifications are
# just logged to the server console instead of actually emailed.
RESEND_API_KEY=
# Needs a verified sending domain in Resend; "onboarding@resend.dev" works
# as a sandbox sender until you verify one.
RESEND_FROM_EMAIL=GulfJobCopilot <onboarding@resend.dev>
# Where admin notifications are sent; defaults to moustafa_sleiman@hotmail.com
# in code if unset.
ADMIN_NOTIFICATION_EMAIL=

# Shared secret for the Supabase "new profiles row" Database Webhook that
# hits /api/notify/new-signup (Database > Webhooks > table "profiles",
# event "Insert", header "x-webhook-secret: <this value>"). Distinct from
# LEMONSQUEEZY_WEBHOOK_SECRET above — this one is Supabase-to-app, not
# Lemon-Squeezy-to-app.
SUPABASE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
